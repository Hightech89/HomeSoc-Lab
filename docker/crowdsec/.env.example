# Home SOC CrowdSec deployment settings

# Set this to the host timezone so CrowdSec interprets local log timestamps correctly.
TZ=America/Chicago

# Pinned Debian image for reproducible deployments and journald support.
CROWDSEC_IMAGE_TAG=v1.7.8-debian
CROWDSEC_CONTAINER_NAME=crowdsec

# CrowdSec Local API exposure. Keep this loopback-only unless another trusted service needs access.
CROWDSEC_LAPI_BIND=127.0.0.1
CROWDSEC_LAPI_PORT=8080

# Existing Home SOC Docker network. Create this network before deployment if it does not exist.
HOMESOC_DOCKER_NETWORK=homesoc

# Host log directory mounted read-only into the container.
HOST_LOG_DIR=/var/log

# Host systemd journal directory mounted read-only into the container.
# Raspberry Pi OS may write SSH authentication events to journald instead of /var/log/auth.log.
# If persistent journald storage is enabled on the Pi, set this to /var/log/journal.
HOST_JOURNAL_DIR=/run/log/journal

# Linux + SSH are the initial Home SOC detection scope.
CROWDSEC_COLLECTIONS="crowdsecurity/linux crowdsecurity/sshd"

# Optional group ID used by the CrowdSec container when reading mounted logs.
# Set this to a host group that can read the relevant log or journal files if the default does not work.
CROWDSEC_GID=1000

# Named volumes used for persistent CrowdSec state.
CROWDSEC_CONFIG_VOLUME=crowdsec-config
CROWDSEC_DATA_VOLUME=crowdsec-data
